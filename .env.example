# Environment Configuration Template
# Copy this file to .env and fill in your values

# ===== Required Configuration =====

# Gmail root filter label (optional)
# Used for organizing sub-labels under a parent label
# This is the name prefix for your job hunting labels
# Example: If you have labels like "#job-hunt/Applied", "#job-hunt/Interview"
# then set this to "#job-hunt"
# Default: #job-hunt
GMAIL_ROOT_FILTER_LABEL=#job-hunt

# Your Gmail address (used to exclude your own replies from statistics)
USER_EMAIL_ADDRESS=your-email@gmail.com

# ===== PostgreSQL Database =====
# PostgreSQL is required for local development, CI, and Docker.
DB_ENGINE=postgresql

# These must match the POSTGRES_* vars in docker-compose.yml
DB_NAME=tracker
DB_USERNAME=gmailtracker
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ===== API Keys =====

# SAM.gov API key (for RFP/contract opportunity search and description fetching)
# Get one at: https://sam.gov/content/entity-information/api
SAM_GOV_API_KEY=

# News API keys (optional)
NEWS_API_KEY=
GOOGLE_NEWS_API_KEY=

# ===== Django =====

# Django secret key (will auto-generate if not provided)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# IMPORTANT: Keep this secret! Never share or commit to git.
DJANGO_SECRET_KEY=

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
# Example: localhost,127.0.0.1,myapp.azurecontainerapps.io
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Application Settings =====

# Default start date for reports (YYYY-MM-DD)
REPORTING_DEFAULT_START_DATE=2025-02-14

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Timezone setting
TZ=America/New_York

# ===== ML Model Configuration =====

# Minimum confidence threshold for auto-review (0.0-1.0)
AUTO_REVIEW_CONFIDENCE=0.85

# Minimum confidence for ML classification (0.0-1.0)
ML_CONFIDENCE_THRESHOLD=0.55

# ===== Gmail Ingestion Configuration =====

# Default days to look back when ingesting
DEFAULT_DAYS_BACK=7

# Maximum messages per ingestion batch
MAX_MESSAGES_PER_BATCH=500

# ===== Ghosted Detection Configuration =====

# Ghosted detection threshold (in days)
GHOSTED_DAYS_THRESHOLD=30

# ===== Notes =====
# - Never commit .env to version control
# - See GETTING_STARTED.md for full setup instructions
# - model/token.pickle and json/credentials.json must be migrated separately (not in git)
