{
  "name": "theme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "watch": "tailwindcss -i ./src/styles.css -o ../static/css/dist/styles.css --watch",
    "start": "npm run watch"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
